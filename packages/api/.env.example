# Owner connection, used only by db:migrate.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Request handlers. Role has no BYPASSRLS.
DATABASE_URL_APP=postgres://rua_app:rua_app@127.0.0.1:54322/postgres
# Inngest functions and inbound hooks.
DATABASE_URL_WORKER=postgres://rua_worker:rua_worker@127.0.0.1:54322/postgres

SUPABASE_URL=http://127.0.0.1:54321
# Set for local `supabase start`, which signs JWTs with HS256. Leave empty in
# production to verify against the project's JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Report addresses are <local part>@REPORTS_DOMAIN.
REPORTS_DOMAIN=reports.example.net
PUBLIC_URL=http://localhost:3000
PORT=3000
