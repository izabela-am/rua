# Owner connection, used only by db:migrate.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Request handlers. Role has no BYPASSRLS.
DATABASE_URL_APP=postgres://rua_app:rua_app@127.0.0.1:54322/postgres
# Inngest functions and inbound hooks.
DATABASE_URL_WORKER=postgres://rua_worker:rua_worker@127.0.0.1:54322/postgres

SUPABASE_URL=http://127.0.0.1:54321
# Set for local `supabase start`, which signs JWTs with HS256. Leave empty in
# production to verify against the project's JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Report addresses are <local part>@REPORTS_DOMAIN.
REPORTS_DOMAIN=reports.example.net
PUBLIC_URL=http://localhost:3000
PORT=3000

# Resend. Without an API key, inbound attachments are read from LOCAL_DATA_DIR/inbound.
RESEND_API_KEY=
# Signing secret of the Resend webhook that delivers email.received.
RESEND_INBOUND_SECRET=whsec_bG9jYWwtZGV2LXNlY3JldC1ub3QtZm9yLXByb2Q=
LOCAL_DATA_DIR=.local
INNGEST_DEV=1
ALERT_FROM=Rua <alerts@example.net>

# AES-256-GCM keys for tenant secrets: RUA_KEK_<id>=<32 bytes base64>.
# Generate with: openssl rand -base64 32
RUA_KEK_CURRENT=k1
RUA_KEK_k1=
