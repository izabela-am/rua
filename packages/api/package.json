{
  "name": "@rua/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "start": "node dist/server.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "replay": "tsx --env-file-if-exists=.env src/scripts/replay.ts",
    "fetch-asn": "tsx src/scripts/fetch-asn.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@rua/dmarc-parser": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "inngest": "^4.26.2",
    "jose": "^6.2.17",
    "postgres": "^4.1.0",
    "resend": "^6.38.0",
    "winston": "^3.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15"
  }
}
